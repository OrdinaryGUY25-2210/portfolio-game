# Copy this file to ".env" and fill in the two values below.
# Both values come from your Supabase project dashboard:
# Project Settings -> API -> Project URL / anon public key
# See README.md "Supabase Setup (Dashboard-only)" for the full walkthrough.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Name of the public Storage bucket holding pixel-art assets (webp images)
VITE_SUPABASE_BUCKET=portfolio-assets
